<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="material-table" author="Michal">
        <createTable tableName="material">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(255)"/>
            <column name="order_date" type="date"/>
            <column name="price" type="numeric(19,2)"/>
            <column name="quantity" type="int"/>
            <column name="construction_id" type="bigint"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="material" baseColumnNames="construction_id"
                                 referencedTableName="construction" referencedColumnNames="id"
                                 constraintName="fk_material_construction"/>
    </changeSet>
</databaseChangeLog>
